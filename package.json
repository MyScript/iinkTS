{
  "name": "iink-ts",
  "version": "1.0.0-buildVersion",
  "packageManager": "yarn@4.14.1",
  "engines": {
    "node": ">=22"
  },
  "description": "iinkTS is the fastest way to integrate handwriting panel and recognition in your webapp",
  "license": "Apache-2.0",
  "main": "dist/iink.min.js",
  "module": "dist/iink.esm.js",
  "type": "module",
  "types": "dist/iink.d.ts",
  "keywords": [
    "myscript",
    "javascript",
    "typescript",
    "developer",
    "handwriting",
    "recognition",
    "cloud",
    "iink"
  ],
  "files": [
    "dist",
    "package.json"
  ],
  "homepage": "https://myscript.github.io/iinkTS/",
  "repository": "git://github.com/MyScript/iinkTS.git",
  "scripts": {
    "lint": "eslint",
    "lint:src": "eslint src/",
    "lint:tu": "eslint test/unit/",
    "lint:te": "eslint --config=./test/examples/eslint.config.mjs ./test/examples",
    "prettier": "prettier --write ./src/**/*.ts ./test/**/*.ts",
    "dev": "rollup -c config/rollup.config.dev.mjs -w --sourcemap",
    "dev:tldraw": "cd ./examples/custom-rendering/tldraw-websocket-client && yarn dev",
    "test:unit": "jest --config=test/unit/jest.config.js --detectOpenHandles",
    "test:examples": "playwright test --config=test/examples/playwright.config.js",
    "copy:to:tldraw": "cp -r dist/ examples/custom-rendering/tldraw-websocket-client/node_modules/iink-ts/",
    "install:tldraw": "cd ./examples/custom-rendering/tldraw-websocket-client && yarn install",
    "prepare:tldraw": "npm-run-all build:lib copy:to:tldraw",
    "build:tldraw": "cd ./examples/custom-rendering/tldraw-websocket-client && yarn build",
    "build:lib": "rollup -c config/rollup.config.build.mjs --sourcemap",
    "build:docs": "typedoc",
    "build": "npm-run-all lint test:unit build:lib build:docs copy:to:tldraw build:tldraw"
  },
  "dependencies": {
    "json-css": "^1.5.6"
  },
  "devDependencies": {
    "@eslint/eslintrc": "^3.3.6",
    "@eslint/js": "^10.0.1",
    "@playwright/test": "^1.61.1",
    "@rollup/plugin-alias": "^6.0.0",
    "@rollup/plugin-commonjs": "^29.0.3",
    "@rollup/plugin-node-resolve": "^16.0.3",
    "@rollup/plugin-terser": "^1.0.0",
    "@types/jest": "^30.0.0",
    "@typescript-eslint/eslint-plugin": "^8.64.0",
    "@typescript-eslint/parser": "^8.64.0",
    "dotenv": "^17.4.2",
    "eslint": "^10.7.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-jest": "^29.15.4",
    "eslint-plugin-playwright": "^2.10.5",
    "eslint-plugin-prettier": "^5.5.6",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "globals": "^17.7.0",
    "jest": "^30.4.2",
    "jest-canvas-mock": "^2.5.8",
    "jest-environment-jsdom": "^30.4.1",
    "jest-extended": "^7.0.0",
    "jest-fetch-mock": "^3.2.0",
    "jest-transform-css": "^6.0.3",
    "jest-websocket-mock": "^2.5.0",
    "npm-run-all": "^4.1.5",
    "postcss": "^8.5.19",
    "prettier": "3.9.5",
    "rollup": "^4.62.2",
    "rollup-plugin-delete": "^3.0.2",
    "rollup-plugin-dts": "^6.4.1",
    "rollup-plugin-livereload": "^2.0.5",
    "rollup-plugin-postcss": "^4.0.2",
    "rollup-plugin-serve": "^3.0.0",
    "rollup-plugin-svg-import": "^3.0.0",
    "rollup-plugin-typescript2": "^0.36.0",
    "rollup-plugin-web-worker-loader": "^1.7.0",
    "ts-jest": "^29.4.11",
    "tslib": "^2.8.1",
    "typedoc": "^0.28.20",
    "typedoc-plugin-expand-object-like-types": "^0.1.2",
    "typedoc-plugin-inline-sources": "^1.3.0",
    "typedoc-plugin-missing-exports": "^4.1.4",
    "typescript": "^5.9.3"
  },
  "resolutions": {
    "js-yaml": "^4.2.0"
  }
}
